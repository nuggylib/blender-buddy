/* Application-level styles for Blender Buddy. */

/* The shared config vocabulary. The dashboard and the per-section detail
   screens render the same kinds of line — a heading, a configured value, a
   muted sub-detail — so these are app-level classes rather than per-screen
   copies. */
.section-title {
    text-style: bold;
    color: $accent;
}

.config-value {
    width: 100%;
}

.config-detail {
    color: $text-muted;
}

/* Shown in place of the sections when there is no valid config. */
#setup-prompt {
    width: auto;
    padding: 1 2;
}

/* -- dashboard ----------------------------------------------------------- */

/* A top-aligned column of config sections (Blender → Models → Godot), not a
   single centered line. */
DashboardScreen #config-panel {
    width: 100%;
    height: auto;
    padding: 1 2;
}

/* Sections are focusable cards (SectionCard): arrow keys move between them and
   enter opens one. The left rail is painted on *every* card, not just the
   focused one, so only its color changes with focus — a border that appeared on
   focus would shift the row's text sideways as the user moved through. */
DashboardScreen .section {
    width: 100%;
    height: auto;
    margin-bottom: 1;
    border-left: thick $panel;
    padding-left: 1;
}

DashboardScreen .section:focus {
    border-left: thick $accent;
    background: $boost;
}

/* -- detail screens ------------------------------------------------------ */

#detail-panel {
    width: 100%;
    height: auto;
    padding: 1 2;
}

/* Sets the placeholder note apart from the values above it. */
#placeholder-note {
    margin-top: 1;
}

/* -- Models screen ------------------------------------------------------- */

ModelsScreen #models-summary {
    margin-bottom: 1;
}

ModelsScreen .models-group {
    width: 100%;
    height: auto;
    margin-bottom: 1;
}

ModelsScreen .models-directory {
    text-style: bold;
}

ModelsScreen .models-files {
    width: 100%;
    height: auto;
}

/* Model rows are focusable, so — as on the dashboard — the rail is painted on
   every row and only its color changes, keeping the text from shifting
   sideways as focus moves. */
ModelsScreen .model-row {
    width: 100%;
    height: auto;
    border-left: thick $panel;
    padding-left: 1;
}

ModelsScreen .model-row:focus {
    border-left: thick $accent;
    background: $boost;
}

ModelsScreen .fix-step {
    width: 100%;
    height: auto;
}

/* The model list scrolls; `height: 1fr` gives it whatever is left between the
   header, the docked fix block, and the footer. `can_focus=False` on the
   container (set in Python) keeps it out of the row focus chain. */
ModelsScreen #detail-panel {
    height: 1fr;
}

/* Sibling of the 1fr scroller, not docked: a docked container with auto height
   renders at one row. Capped so it can't crowd out the list. */
ModelsScreen #fix-panel {
    width: 100%;
    height: auto;
    max-height: 50%;
    padding: 0 2;
    border-top: solid $panel;
}
